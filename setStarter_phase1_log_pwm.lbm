;;
;; setStarter_phase1_log_pwm.lbm - Phase 1: Log PPM input for debugging
;;
;; This script reads PPM input and logs:
;; - PPM duty cycle (0-1)
;; - PPM percentage (0-100)
;;
;; Note: VESC PPM input is read via get-PPM (not get-pwm-input-duty)

;; Configuration
(def *update-interval* 0.05)  ;; Update every 0.05s (20Hz)
(def *log-interval* 20)       ;; Log every 20 updates (1s)

;; Counter for logging
(def *log-counter* 0)

;; === MAIN ===

(print "=== VESC HP Phase 1: PPM Logger ===")
(print "PPM Input: Default channel")
(print "Update Rate: 20Hz (every 0.05s)")
(print "Log Interval: 1s")
(print "====================================")

;; Main loop - log PPM input
(loopwhile t {
        ;; Read PPM directly (0.0 - 1.0)
        (var ppm-duty (get-PPM))
        (var ppm-percent (* ppm-duty 100.0))

        ;; Increment counter
        (setq *log-counter* (+ *log-counter* 1))

        ;; Log every 20 updates (1 second)
        (if (>= *log-counter* *log-interval*)
            (progn
                (setq *log-counter* 0)
                (print "PPM:")
                (print ppm-percent)
                (print "% duty (")
                (print ppm-duty)
                (print ")")))

        ;; Reset timeout to prevent fault
        (timeout-reset)

        (sleep *update-interval*)
})
