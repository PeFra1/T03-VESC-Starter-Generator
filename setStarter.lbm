;;
;; setStarter.lbm - Dual-mode control with threshold
;;
;; This script reads PWM input and switches between RPM mode and duty cycle mode
;; based on a configurable threshold.
;;
;; Architecture:
;; - Input: get-PPM returns -1.0 to +1.0 (PWM duty cycle)
;; - Threshold: Configurable PWM threshold (default 20% = 0.2)
;; - Output:
;;   - RPM mode (PWM < threshold): set-rpm with fixed 5000 RPM
;;   - Duty mode (PWM >= threshold): set-duty
;;
;; Usage:
;; 1. Upload to VESC HP
;; 2. Script runs automatically after upload

(def *update-interval* 0.05)
(def *threshold* 0.2)

(loopwhile t {
    (var pwm-duty (get-PPM))

    (if (< pwm-duty *threshold*)
        (set-rpm 5000)
        (set-duty pwm-duty))

    (timeout-reset)
    (sleep *update-interval*)
})
